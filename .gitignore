PROJECT_SUMMARY.md

# Ignore Astro and Node build artifacts in promptpack-docs.
# `build/` (not `dist/`) because astro.config.mjs sets outDir there, so that
# deploy.yml keeps uploading the path it always did.
promptpack-docs/build/
promptpack-docs/.astro/
promptpack-docs/.docusaurus/
promptpack-docs/node_modules/

# Ignore accidental top-level docs build artifacts
docs/build/
docs/.docusaurus/
docs/node_modules/

# Ignore OS and editor files
.DS_Store
.vscode/
.idea/
*.log
node_modules/
build/
.astro/
.docusaurus/
/local-backlog/
