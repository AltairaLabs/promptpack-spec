---
/**
 * The standards strip: licence, current draft and status, in mono.
 *
 * Sits between the AltairaLabs family bar and the product masthead. On the
 * Docusaurus site it was rendered from the Navbar swizzle, because page content
 * started below the masthead and could not reach this slot; here the landing
 * page composes its own chrome, so it is an ordinary component.
 *
 * Marketing home only — the docs shell goes straight from family bar to
 * masthead, as it did before.
 *
 * PromptPack is the one product whose spec and implementation carry different
 * licences: the specification text is CC-BY-4.0, the reference code MIT. The
 * registry has a single `licence` field per product and records the repo's MIT,
 * so `licenceLabel()` supplies that half and CC-BY-4.0 is stated here. If a
 * second product ever splits the same way, that is the point to give the
 * registry a field for it rather than write it in a second component.
 */
import { productById, licenceLabel } from '@altairalabs/brand/products';
import schema from '../../static/schema/latest/promptpack.schema.json';

const promptpack = productById('promptpack')!;
const specVersion = 'v' + schema.version;
---

<div class="strip">
  <div class="inner">
    <span class="open">● open specification</span>
    <span class="sep">·</span>
    <span>spec cc-by-4.0</span>
    <span class="sep">·</span>
    <span>code {licenceLabel(promptpack).split(' · ')[0].toLowerCase()}</span>
    <span class="sep">·</span>
    <span>current draft {specVersion}</span>
    <span class="sep">·</span>
    <span>status: stable</span>
    <span class="from">an open standard from altairalabs</span>
  </div>
</div>

<style>
  .strip {
    background: var(--ink-void);
    border-bottom: var(--border-hairline) solid var(--hairline);
  }

  .inner {
    align-items: center;
    color: var(--star-900);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-size-mono-label);
    gap: var(--space-7);
    letter-spacing: var(--tracking-label);
    margin: 0 auto;
    max-width: 1180px;
    padding: var(--space-2) var(--space-14);
    text-transform: uppercase;
  }

  .open {
    color: var(--pp-accent);
  }

  .sep {
    opacity: 0.4;
  }

  .from {
    margin-left: auto;
    opacity: 0.7;
  }

  @media screen and (max-width: 996px) {
    .from {
      display: none;
    }
  }

  @media screen and (max-width: 640px) {
    .inner {
      gap: var(--space-4);
      padding-inline: var(--space-6);
    }
  }
</style>
