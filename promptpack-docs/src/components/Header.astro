---
/**
 * Starlight's header with the AltairaLabs masterbrand family bar above it.
 *
 * The Docusaurus site carried the family bar in a Navbar swizzle. That swizzle
 * is deleted; this is the Starlight equivalent, and it renders the bar from
 * @altairalabs/brand rather than the 233-line hand-written React port that
 * used to live in src/components/FamilyBar/.
 *
 * `docs` puts the bar in its full-width variant, pinned inside the fixed
 * header; family-bar-starlight.css reserves the matching height so the header
 * neither overlaps the page nor leaves a gap.
 */
import type { Props } from '@astrojs/starlight/props';
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import FamilyBar from '@altairalabs/brand/FamilyBar.astro';
---

<div class="header-wrapper">
  <FamilyBar current="promptpack" docsHref="/docs/getting-started/" docs />
  <DefaultHeader {...Astro.props}><slot /></DefaultHeader>
</div>

<style>
  .header-wrapper {
    display: contents;
  }
</style>
