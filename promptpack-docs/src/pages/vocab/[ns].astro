---
/**
 * Human-readable page for a minted RFC 0016 vocabulary. A term IRI such as
 * https://promptpack.org/vocab/hipaa#PHI dereferences here (GitHub Pages
 * cannot content-negotiate), so every term carries an id equal to its local
 * name. The machine-readable forms are generated by scripts/sync-vocab.js from
 * the same vocab/<ns>.json, linked as rel="alternate" and embedded as JSON-LD.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { toJsonLd } from '../../../scripts/sync-vocab.js';

export function getStaticPaths() {
  const files = import.meta.glob('../../../vocab/*.json', { eager: true, import: 'default' });
  return Object.values(files).map((vocab) => ({ params: { ns: vocab.prefix }, props: { vocab } }));
}

const { vocab } = Astro.props;
const p = vocab.prefix;
const slots = [...new Set(vocab.terms.map((t) => t.slot))];

const head = [
  { tag: 'link', attrs: { rel: 'alternate', type: 'text/turtle', href: `/vocab/${p}.ttl` } },
  { tag: 'link', attrs: { rel: 'alternate', type: 'application/ld+json', href: `/vocab/${p}.jsonld` } },
  { tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(toJsonLd(vocab)) },
];
---

<StarlightPage frontmatter={{ title: `${vocab.title} (${p}:)`, description: vocab.description, head }}>
  <dl class="ppVocabMeta">
    <dt>Namespace</dt><dd><code>{vocab.namespace}</code></dd>
    <dt>Prefix</dt><dd><code>{p}:</code> — well-known, no declaration needed in <code>vocabularies</code></dd>
    <dt>Data</dt><dd><a href={`/vocab/${p}.ttl`}>Turtle</a> · <a href={`/vocab/${p}.jsonld`}>JSON-LD</a></dd>
  </dl>

  <p>{vocab.description}</p>

  {slots.map((slot) => (
    <>
      <h2 id={`slot-${slot.replace(/\W+/g, '-')}`}>For <code>{slot}</code></h2>
      {vocab.terms.filter((t) => t.slot === slot).map((t) => (
        <section class="ppVocabTerm" id={t.id}>
          <h3><a href={`#${t.id}`}><code>{p}:{t.id}</code></a> — {t.label}</h3>
          <p>{t.definition}</p>
          {t.seeAlso && (
            <p class="ppVocabSource">Defined in <a href={t.seeAlso}>{t.source}</a></p>
          )}
        </section>
      ))}
    </>
  ))}

  <p>
    Minted under RFC 0016's rule: a term is published here only where no external vocabulary
    supplies it, and its meaning is fixed. See the
    <a href="/docs/spec/schema-guide#well-known-prefixes-v180">well-known prefixes</a> and
    <a href="/docs/rfcs/governance-and-policy-annotation#minted-terms">RFC 0016</a>.
  </p>
</StarlightPage>

<style>
  .ppVocabMeta { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
  .ppVocabMeta dd { margin: 0; overflow-wrap: anywhere; }
  .ppVocabTerm { scroll-margin-top: 5rem; }
  .ppVocabTerm h3 a { text-decoration: none; }
  .ppVocabSource { font-size: var(--sl-text-sm); }
</style>
